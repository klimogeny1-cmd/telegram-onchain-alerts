# Copy this file to .env and fill it in. Never commit the real .env (see .gitignore).
# Validate without touching the network: python3 main.py --check

# --- Required -----------------------------------------------------------------------
# Bot token from @BotFather (looks like 123456789:AAE...).
BOT_TOKEN=
# Where posts go: a channel username (@your_channel, the bot must be an admin there)
# or a numeric chat id (channels usually look like -100xxxxxxxxxx).
CHANNEL_ID=

# --- Core -----------------------------------------------------------------------------
# Chains to watch, comma-separated. Use DexScreener's chainId spelling, e.g.:
# solana, ethereum, base, arbitrum, optimism, bsc, polygon, avalanche.
CHAINS=solana,base

# Minutes between monitoring cycles. Also sets the default "new pair" window (a pair
# counts as new if it appeared since roughly the last cycle) - override that separately
# with NEW_PAIR_WINDOW_MIN below if you want a different window.
INTERVAL_MIN=60

# Pairs below this liquidity (USD) are dropped before any analysis - the main noise
# filter. A pair with unknown liquidity (DexScreener does not always report it for very
# new pairs) is also dropped, not assumed to pass.
MIN_LIQUIDITY_USD=5000

# --- Discovery & watchlist (optional) --------------------------------------------------
# DexScreener's public API has no "every new pair on chain X" endpoint (see README "How
# pair discovery works"), so this bot finds candidates by searching for a token symbol
# commonly paired against on each chain, then filters the results down to CHAINS. Leave
# empty to use the built-in per-chain defaults (SOL for solana, WETH for base/ethereum/
# arbitrum/optimism, BNB for bsc, ...). Set this to use the same query text for every
# configured chain instead:
# DISCOVERY_QUERIES=SOL,USDC

# A project's own token(s), always checked directly via /token-pairs/v1 in addition to
# whatever DISCOVERY_QUERIES turns up. Format: chain:tokenAddress, comma-separated.
# WATCHLIST=solana:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- New pairs & volume anomalies ------------------------------------------------------
# Override the "new pair" window independently of INTERVAL_MIN (minutes).
# NEW_PAIR_WINDOW_MIN=60
# A pair is a "volume spike" when 1h volume is at least this many times the flat 24h
# hourly average (volume_h24 / 24).
VOLUME_SPIKE_RATIO=3
# ...but only if 1h volume also clears this USD floor, so a jump from $5 to $40 on a
# dead pair is never reported as a "spike".
MIN_VOLUME_USD_FOR_SPIKE=1000

# --- Risk flags (rule-based, not advice - see README) -----------------------------------
# Liquidity below this (USD) gets a "Low liquidity" flag next to the pair (separate from,
# and normally higher than, the MIN_LIQUIDITY_USD hard floor above).
RISK_LOW_LIQUIDITY_USD=25000
# Pairs younger than this (minutes) get a "Very new pair" flag.
RISK_NEW_PAIR_MIN=30
# 24h volume at least this many times liquidity gets a "High volume vs liquidity" flag.
RISK_VOL_LIQ_RATIO=5

# --- Everything else (sensible defaults, override only if you need to) -----------------
# Pairs shown per post before it switches to "+ N more not shown".
# MAX_ITEMS_PER_POST=10
# Where the dedup database lives (default: ./state/seen.db next to this file).
# STATE_DB_PATH=
# DexScreener HTTP client: request timeout (seconds), minimum gap between requests
# (seconds - see README "Data source & rate limits"), and cache lifetime (seconds).
# REQUEST_TIMEOUT_SEC=15
# MIN_REQUEST_INTERVAL_SEC=1.2
# CACHE_TTL_SEC=60
# LOG_LEVEL=INFO
