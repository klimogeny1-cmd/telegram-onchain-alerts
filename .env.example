# Copy this file to .env and fill it in. Never commit the real .env (see .gitignore).
# Validate without touching the network:      python3 main.py --check
# Verify the Solami key against live mainnet: python3 main.py --check-live

# --- Required -----------------------------------------------------------------------
# Bot token from @BotFather (looks like 123456789:AAE...).
BOT_TOKEN=
# Where posts go: a channel username (@your_channel, the bot must be an admin there)
# or a numeric chat id (channels usually look like -100xxxxxxxxxx).
CHANNEL_ID=
# Solami API key: a *standard* key (starts with sk_) whose role has the DataApi
# permission - that one key works for the Blur stream, RPC and the Data API.
# Create it at solami.dev -> dashboard -> API keys. Never logged (see README "Secrets").
SOLAMI_API_KEY=

# --- What to watch ---------------------------------------------------------------------
# TAPE_MODE=auto (default) -> "watchlist" when WATCH_MINTS is set, otherwise "firehose".
#   watchlist: your project's token(s) - every large trade, liquidity move, new pool,
#              graduation, breakout, big transfer/burn, top-holder change and authority
#              change, plus an hourly summary.
#   firehose:  the whole Solana market with high thresholds - whale trades, big
#              liquidity removals, graduations, big breakouts, a launch digest.
# TAPE_MODE=auto
# Token mint addresses, comma-separated (watchlist mode). Example: BONK
# WATCH_MINTS=DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263

# --- Thresholds (defaults depend on the mode; shown: watchlist / firehose) -------------
# A trade is "large" at or above this USD value (5000 / 50000). In firehose mode the
# filter runs on Solami's side (Blur min_volume_usd), so smaller swaps never download.
# LARGE_TRADE_USD=
# Liquidity adds/removes at or above this USD value (2500 / 50000) ...
# LIQ_ALERT_USD=
# ... or (watchlist only) at or above this share of the pool's quote-side reserve.
# LIQ_ALERT_PCT=10
# Report liquidity *adds* too, not only removals (true / false).
# LIQ_REPORT_ADDS=
# Firehose: Solami surge/radar breakouts need at least this volume multiple and
# market cap at trigger (USD). Watchlist mode posts every breakout of your token.
# SURGE_MIN_MULTIPLE=5
# SURGE_MIN_MCAP_USD=250000
# Watchlist: top-20 holder balance changes and single transfers/mints/burns at or above
# this share of supply (%).
# HOLDER_CHANGE_PCT=0.5
# Rule-based flags (README "Rule-based flags"): top-10 holder concentration (% of
# supply) and swap price impact (%).
# TOP10_FLAG_PCT=50
# PRICE_IMPACT_FLAG_PCT=10

# --- Timing ----------------------------------------------------------------------------
# Real-time items are batched into one post every FLUSH_SEC seconds.
# FLUSH_SEC=60
# Hard cap on posts per minute (Telegram allows ~20/min per channel).
# MAX_POSTS_PER_MIN=6
# Watchlist: top-holder poll and mint/freeze authority re-check intervals (minutes).
# HOLDERS_POLL_MIN=5
# AUTHORITY_RECHECK_MIN=30
# Watchlist summary / firehose launch digest, aligned to the clock (minutes, 0 = off).
# SUMMARY_EVERY_MIN=60
# DIGEST_EVERY_MIN=15

# --- Solami endpoints (defaults are the global anycast endpoints) -------------------------
# Pin a region by prefixing the host: fra. / ams. / nyc. (see solami.dev/docs/endpoints).
# SOLAMI_WS_URL=wss://ws.solami.dev/data/subscribe
# SOLAMI_RPC_URL=https://rpc.solami.dev/sol
# SOLAMI_API_URL=https://api.solami.dev
# Client-side RPC rate cap (requests/second). Solami's Free plan allows 5, Dev 50, Pro 200
# (solami.dev/docs/pricing). The bot needs far less than that.
# SOLAMI_RPC_MAX_RPS=4
# Use the Data API (REST) for token symbols the stream has not named yet.
# SOLAMI_DATA_API=true

# --- Everything else ---------------------------------------------------------------------
# Items shown per section before "+ N more not shown".
# MAX_ITEMS_PER_POST=10
# Where the dedup/state database lives (default: ./state/seen.db next to this file).
# STATE_DB_PATH=
# REQUEST_TIMEOUT_SEC=15
# LOG_LEVEL=INFO

# =======================================================================================
# Legacy: the original keyless DexScreener polling tape. Only read when
# DATA_SOURCE=dexscreener (default: solami). See README "Legacy DexScreener mode".
# DATA_SOURCE=solami
# CHAINS=solana,base
# INTERVAL_MIN=60
# MIN_LIQUIDITY_USD=5000
# DISCOVERY_QUERIES=SOL,USDC
# WATCHLIST=solana:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# NEW_PAIR_WINDOW_MIN=60
# VOLUME_SPIKE_RATIO=3
# MIN_VOLUME_USD_FOR_SPIKE=1000
# RISK_LOW_LIQUIDITY_USD=25000
# RISK_NEW_PAIR_MIN=30
# RISK_VOL_LIQ_RATIO=5
# MIN_REQUEST_INTERVAL_SEC=1.2
# CACHE_TTL_SEC=60
